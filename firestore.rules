rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GRANULAR SECURITY HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ahsanhayat092@gmail.com' ||
        request.auth.uid == 'org_ahsanhayat092_gmail_com' ||
        exists(/databases/$(database)/documents/system_admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // Tournament Authorization Helpers
    // -------------------------------------------------------------------------

    // Check if user is the OWNER of a tournament
    function isTournamentOwner(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/tournaments/$(tourneyId)) &&
          (
            get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.ownerId == request.auth.uid ||
            (
              !('ownerId' in get(/databases/$(database)/documents/tournaments/$(tourneyId)).data) &&
              get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.ownerEmail == request.auth.token.email
            )
          )
        ) ||
        (
          exists(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)) &&
          get(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)).data.role == 'OWNER'
        )
      );
    }

    // Check if user is OWNER or ADMIN (roster, fixtures, operations, assign scorers)
    function isTournamentAdmin(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        isTournamentOwner(tourneyId) ||
        (
          exists(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)).data.role == 'ADMIN' ||
            get(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)).data.role == 'OWNER'
          )
        )
      );
    }

    // Check if user is assigned as SCORER, ADMIN, or OWNER for a tournament
    function isTournamentScorer(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        isTournamentAdmin(tourneyId) ||
        (
          exists(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)) &&
          get(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)).data.role == 'SCORER'
        )
      );
    }

    // -------------------------------------------------------------------------
    // Team Authorization Helpers
    // -------------------------------------------------------------------------

    // Check if user is manager/owner of a team
    function isTeamManager(teamId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/teams/$(teamId)) &&
          (
            get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid ||
            (
              !('ownerId' in get(/databases/$(database)/documents/teams/$(teamId)).data) &&
              get(/databases/$(database)/documents/teams/$(teamId)).data.ownerEmail == request.auth.token.email
            )
          )
        )
      );
    }

    // Check if user can score a match
    function canScoreMatch(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (tourneyId != null && isTournamentScorer(tourneyId))
      );
    }

    // Data validation helper
    function isValidNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // =========================================================================
    // 2. TOURNAMENTS COLLECTION
    // =========================================================================
    match /tournaments/{tournamentId} {
      allow read: if true;

      // Creation requires authenticated user and valid name & ownerId
      allow create: if isSignedIn() &&
        isValidNonEmptyString(request.resource.data.name, 120) &&
        (request.resource.data.ownerId == request.auth.uid || isSuperAdmin());

      // Update / Delete strictly requires owner or super admin; prevents changing ownerId unless super admin
      allow update: if isSignedIn() &&
        isTournamentOwner(tournamentId) &&
        (
          !('ownerId' in request.resource.data) ||
          !('ownerId' in resource.data) ||
          request.resource.data.ownerId == resource.data.ownerId ||
          isSuperAdmin()
        );

      allow delete: if isSignedIn() && isTournamentOwner(tournamentId);
    }

    // =========================================================================
    // 3. TEAMS & ROSTERS COLLECTION
    // =========================================================================
    match /teams/{teamId} {
      allow read: if true;

      // Creation requires team manager UID binding or tournament admin creating for tournament
      allow create: if isSignedIn() &&
        isValidNonEmptyString(request.resource.data.name, 100) &&
        (
          request.resource.data.ownerId == request.auth.uid ||
          (request.resource.data.tournamentId != null && isTournamentAdmin(request.resource.data.tournamentId)) ||
          isSuperAdmin()
        );

      // Updates/Deletes restricted to team manager, tournament admin, or super admin
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.ownerId == request.auth.uid) ||
        (!('ownerId' in resource.data) && resource.data.ownerEmail == request.auth.token.email) ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId))
      ) && (
        !('ownerId' in request.resource.data) ||
        !('ownerId' in resource.data) ||
        request.resource.data.ownerId == resource.data.ownerId ||
        isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.ownerId == request.auth.uid) ||
        (!('ownerId' in resource.data) && resource.data.ownerEmail == request.auth.token.email) ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId))
      );
    }

    // =========================================================================
    // 4. PLAYERS COLLECTION (Multi-Team & Multi-Tournament Enabled)
    // =========================================================================
    match /players/{playerId} {
      allow read: if true;

      // Creation: Team Managers can add players to their roster, Tournament Admins to tournament squads
      allow create: if isSignedIn() &&
        isValidNonEmptyString(request.resource.data.name, 100) &&
        (
          isSuperAdmin() ||
          (request.resource.data.teamId != null && isTeamManager(request.resource.data.teamId)) ||
          (request.resource.data.tournamentId != null && isTournamentAdmin(request.resource.data.tournamentId))
        );

      // Updates: Authorized for the Team Manager of the roster entry, or Tournament Admin of the tournament,
      // or a Team Manager adding/updating participation for their team without blocking multi-team play
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.teamId != null && isTeamManager(resource.data.teamId)) ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        (request.resource.data.teamId != null && isTeamManager(request.resource.data.teamId)) ||
        (request.resource.data.tournamentId != null && isTournamentAdmin(request.resource.data.tournamentId))
      );

      // Deletes: Only the specific team's manager or tournament admin can delete that specific roster entry
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.teamId != null && isTeamManager(resource.data.teamId)) ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId))
      );
    }

    // =========================================================================
    // 5. MATCHES COLLECTION
    // =========================================================================
    match /matches/{matchId} {
      allow read: if true;

      // Match creation and deletion strictly restricted to Tournament Admins (no null bypass!)
      allow create: if isSignedIn() && (
        request.resource.data.tournamentId != null &&
        isTournamentAdmin(request.resource.data.tournamentId)
      );

      allow delete: if isSignedIn() && (
        resource.data.tournamentId != null &&
        isTournamentAdmin(resource.data.tournamentId)
      );

      // Match updates allowed for Tournament Admins (fixtures, config) and Scorers (toss, lineups, POTM, events)
      allow update: if isSignedIn() && (
        resource.data.tournamentId != null &&
        canScoreMatch(resource.data.tournamentId)
      );

      // Match Subcollections: strictly restricted to authorized scorers/admins for this tournament
      match /{subcollection=**} {
        allow read: if true;
        allow write: if isSignedIn() && (
          resource.data.tournamentId != null &&
          canScoreMatch(resource.data.tournamentId)
        );
      }
    }

    // =========================================================================
    // 6. INNINGS & SCORECARD COLLECTIONS
    // =========================================================================
    match /innings/{inningsId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        (request.resource.data.tournamentId != null && canScoreMatch(request.resource.data.tournamentId)) ||
        (request.resource.data.matchId != null && exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId)) && canScoreMatch(get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.tournamentId)) ||
        isSuperAdmin()
      );

      allow update: if isSignedIn() && (
        (resource.data.tournamentId != null && canScoreMatch(resource.data.tournamentId)) ||
        (request.resource.data.tournamentId != null && canScoreMatch(request.resource.data.tournamentId)) ||
        (resource.data.matchId != null && exists(/databases/$(database)/documents/matches/$(resource.data.matchId)) && canScoreMatch(get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.tournamentId)) ||
        isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        isSuperAdmin()
      );

      // Innings Subcollections: restricted to authorized scorers/admins
      match /{subcollection=**} {
        allow read: if true;
        allow write: if isSignedIn() && (
          (resource.data.tournamentId != null && canScoreMatch(resource.data.tournamentId)) ||
          isSuperAdmin()
        );
      }
    }

    match /battingScores/{scoreId} {
      allow read: if true;

      allow create, update: if isSignedIn() && (
        (request.resource.data.tournamentId != null && canScoreMatch(request.resource.data.tournamentId)) ||
        (request.resource.data.inningsId != null && exists(/databases/$(database)/documents/innings/$(request.resource.data.inningsId)) && canScoreMatch(get(/databases/$(database)/documents/innings/$(request.resource.data.inningsId)).data.tournamentId)) ||
        isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        isSuperAdmin()
      );
    }

    match /bowlingScores/{scoreId} {
      allow read: if true;

      allow create, update: if isSignedIn() && (
        (request.resource.data.tournamentId != null && canScoreMatch(request.resource.data.tournamentId)) ||
        (request.resource.data.inningsId != null && exists(/databases/$(database)/documents/innings/$(request.resource.data.inningsId)) && canScoreMatch(get(/databases/$(database)/documents/innings/$(request.resource.data.inningsId)).data.tournamentId)) ||
        isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        isSuperAdmin()
      );
    }

    // =========================================================================
    // 7. STANDINGS & POINTS TABLE
    // =========================================================================
    match /standings/{standingId} {
      allow read: if true;

      allow write: if isSignedIn() && (
        (request.resource.data.tournamentId != null && isTournamentScorer(request.resource.data.tournamentId)) ||
        (resource.data.tournamentId != null && isTournamentScorer(resource.data.tournamentId)) ||
        isSuperAdmin()
      );
    }

    // =========================================================================
    // 8. TOURNAMENT MEMBERS (CIRCULAR DEPENDENCY FIXED & ESCALATION PROTECTED)
    // =========================================================================
    match /tournamentMembers/{memberId} {
      // Circular dependency fix: check direct user identity or parent tournament ownership directly
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        (
          resource.data.tournamentId != null &&
          exists(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)) &&
          (
            get(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)).data.ownerEmail == request.auth.token.email
          )
        )
      );

      // Only Tournament OWNER or Super Admin can create/update/delete members
      // Anti-Privilege Escalation: ADMIN or SCORER cannot promote anyone to OWNER
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.resource.data.tournamentId != null &&
          isTournamentOwner(request.resource.data.tournamentId) &&
          (request.resource.data.role != 'OWNER' || isSuperAdmin())
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          resource.data.tournamentId != null &&
          isTournamentOwner(resource.data.tournamentId) &&
          (request.resource.data.role != 'OWNER' || resource.data.role == 'OWNER' || isSuperAdmin())
        )
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentOwner(resource.data.tournamentId))
      );
    }

    // =========================================================================
    // 9. TOURNAMENT TEAM MEMBERSHIPS (REQUEST & INVITATION LIFECYCLE)
    // =========================================================================
    match /tournamentTeamMemberships/{membershipId} {
      allow read: if true;

      // Creation: Team Managers can request for own team with status "PENDING";
      // Tournament Admins can invite teams with status "INVITED" or "ACCEPTED"
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.tournamentId != null && isTournamentAdmin(request.resource.data.tournamentId)) ||
        (
          request.resource.data.teamId != null &&
          isTeamManager(request.resource.data.teamId) &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.requestedBy == request.auth.uid
        )
      );

      // Update: Tournament Admins can approve/reject; Team Managers can accept/decline for own team
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        (resource.data.teamId != null && isTeamManager(resource.data.teamId))
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        (resource.data.teamId != null && isTeamManager(resource.data.teamId))
      );
    }

    // =========================================================================
    // 10. USER PROFILES (PRIVACY ISOLATED)
    // =========================================================================
    match /users/{userId} {
      // Prevent mass-harvesting: user profiles readable & writable only by owner or super admin
      allow read: if isUser(userId) || isSuperAdmin();
      allow write: if isUser(userId) || isSuperAdmin();
    }

    // =========================================================================
    // 11. SYSTEM ADMINISTRATORS (CIRCULAR DEPENDENCY FIXED)
    // =========================================================================
    match /system_admins/{adminId} {
      allow read: if isSignedIn() && (
        request.auth.uid == adminId ||
        request.auth.token.email == 'ahsanhayat092@gmail.com' ||
        request.auth.uid == 'org_ahsanhayat092_gmail_com'
      );
      allow write: if isSuperAdmin();
    }
  }
}
