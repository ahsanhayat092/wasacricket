rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions & Security Guards
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ahsanhayat092@gmail.com' ||
        request.auth.uid == 'org_ahsanhayat092_gmail_com' ||
        exists(/databases/$(database)/documents/system_admins/$(request.auth.uid))
      );
    }

    // Helper: Check if user is owner of a tournament
    function isTournamentOwner(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/tournaments/$(tourneyId)) &&
          (
            get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.ownerEmail == request.auth.token.email
          )
        )
      );
    }

    // Helper: Check if user is OWNER or ADMIN (roster & schedule managers)
    function isTournamentAdmin(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        isTournamentOwner(tourneyId) ||
        (
          exists(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)).data.role == 'OWNER' ||
            get(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)).data.role == 'ADMIN'
          )
        )
      );
    }

    // Helper: Check if user is authorized for tournament (OWNER, ADMIN, or SCORER)
    function isTournamentAuthorized(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        isTournamentAdmin(tourneyId) ||
        exists(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid))
      );
    }

    // Data Validation helpers
    function isValidNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isValidPositiveNumber(val, max) {
      return val is number && val >= 0 && val <= max;
    }

    // =========================================================================
    // 1. Tournaments Collection
    // =========================================================================
    match /tournaments/{tournamentId} {
      allow read: if true;

      // Creation requires authenticated user and required name & ownerId
      allow create: if isSignedIn() &&
        isValidNonEmptyString(request.resource.data.name, 120) &&
        (request.resource.data.ownerId == request.auth.uid || isSuperAdmin());

      // Update / Delete strictly requires owner or super admin
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email
      );

      // Subcollections under tournament
      match /{subcollection=**} {
        allow read: if true;
        allow write: if isTournamentAuthorized(tournamentId);
      }
    }

    // =========================================================================
    // 2. Teams & Rosters Collection
    // =========================================================================
    match /teams/{teamId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidNonEmptyString(request.resource.data.name, 100);

      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId))
      );
    }

    // =========================================================================
    // 3. Players Collection
    // =========================================================================
    match /players/{playerId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidNonEmptyString(request.resource.data.name, 100);

      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        (resource.data.teamId != null && exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.ownerId == request.auth.uid) ||
        request.resource.data.tournamentId != null
      );
    }

    // =========================================================================
    // 4. Matches, Innings & Live Scoring Scores
    // =========================================================================
    match /matches/{matchId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        request.resource.data.tournamentId == null ||
        isTournamentAdmin(request.resource.data.tournamentId)
      );

      allow update: if isSignedIn() && (
        resource.data.tournamentId == null ||
        isTournamentAuthorized(resource.data.tournamentId)
      );

      allow delete: if isSignedIn() && (
        resource.data.tournamentId == null ||
        isTournamentAdmin(resource.data.tournamentId)
      );

      match /{subcollection=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /innings/{inningsId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        (request.resource.data.tournamentId != null && isTournamentAuthorized(request.resource.data.tournamentId)) ||
        (request.resource.data.matchId != null && exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId)) && isTournamentAuthorized(get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.tournamentId)) ||
        isSuperAdmin()
      );

      allow update: if isSignedIn() && (
        (resource.data.tournamentId != null && isTournamentAuthorized(resource.data.tournamentId)) ||
        (request.resource.data.tournamentId != null && isTournamentAuthorized(request.resource.data.tournamentId)) ||
        isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        isSuperAdmin()
      );

      match /{subcollection=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /battingScores/{scoreId} {
      allow read: if true;

      allow create, update: if isSignedIn() && (
        (request.resource.data.tournamentId != null && isTournamentAuthorized(request.resource.data.tournamentId)) ||
        isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        isSuperAdmin()
      );
    }

    match /bowlingScores/{scoreId} {
      allow read: if true;

      allow create, update: if isSignedIn() && (
        (request.resource.data.tournamentId != null && isTournamentAuthorized(request.resource.data.tournamentId)) ||
        isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        isSuperAdmin()
      );
    }

    // =========================================================================
    // 5. Standings, Rules & Points Table
    // =========================================================================
    match /standings/{standingId} {
      allow read: if true;
      allow write: if isSignedIn() && (
        request.resource.data.tournamentId == null ||
        isTournamentAuthorized(request.resource.data.tournamentId)
      );
    }

    // =========================================================================
    // 6. Tournament Members & Role Escalation Protection
    // =========================================================================
    match /tournamentMembers/{memberId} {
      allow read: if true;

      // Role Escalation Guard: Only the tournament OWNER or Super Admin can assign/modify roles
      allow create, update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.tournamentId != null && isTournamentOwner(request.resource.data.tournamentId)) ||
        (resource.data.tournamentId != null && isTournamentOwner(resource.data.tournamentId))
      );
    }

    match /tournamentTeamMemberships/{membershipId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentAuthorized(resource.data.tournamentId)) ||
        resource.data.requestedBy == request.auth.uid ||
        resource.data.requestedBy == request.auth.token.email
      );
    }

    // =========================================================================
    // 7. Users & Account Profiles (Privacy Isolated)
    // =========================================================================
    match /users/{userId} {
      // Prevent mass data-harvesting of user profiles: only self or super admin
      allow read: if isUser(userId) || isSuperAdmin();
      allow write: if isUser(userId) || isSuperAdmin();
    }

    // =========================================================================
    // 8. System Administrators
    // =========================================================================
    match /system_admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
