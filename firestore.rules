rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GRANULAR SECURITY HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ahsanhayat092@gmail.com' ||
        request.auth.uid == 'org_ahsanhayat092_gmail_com' ||
        exists(/databases/$(database)/documents/system_admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // Tournament Authorization Helpers
    // -------------------------------------------------------------------------

    // Check if user is the OWNER of a tournament
    function isTournamentOwner(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/tournaments/$(tourneyId)) &&
          (
            get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.ownerEmail == request.auth.token.email
          )
        ) ||
        (
          exists(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)) &&
          get(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)).data.role == 'OWNER'
        )
      );
    }

    // Check if user is OWNER or ADMIN (roster, fixtures, operations, assign scorers)
    function isTournamentAdmin(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        isTournamentOwner(tourneyId) ||
        (
          exists(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)).data.role == 'ADMIN' ||
            get(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)).data.role == 'OWNER'
          )
        )
      );
    }

    // Check if user is assigned as SCORER, ADMIN, or OWNER for a tournament
    function isTournamentScorer(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        isTournamentAdmin(tourneyId) ||
        (
          exists(/databases/$(database)/documents/tournaments/$(tourneyId)) &&
          (
            (
              'scorers' in get(/databases/$(database)/documents/tournaments/$(tourneyId)).data &&
              (
                request.auth.uid in get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.scorers ||
                request.auth.token.email in get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.scorers
              )
            ) ||
            (
              'scorerEmails' in get(/databases/$(database)/documents/tournaments/$(tourneyId)).data &&
              request.auth.token.email in get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.scorerEmails
            )
          )
        ) ||
        (
          exists(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)) &&
          get(/databases/$(database)/documents/tournamentMembers/$(tourneyId + '_' + request.auth.uid)).data.role == 'SCORER'
        )
      );
    }

    // -------------------------------------------------------------------------
    // Team Authorization Helpers
    // -------------------------------------------------------------------------

    function isTeamManager(teamId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/teams/$(teamId)) &&
          (
            get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/teams/$(teamId)).data.ownerEmail == request.auth.token.email ||
            get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == ('tm_' + request.auth.token.email)
          )
        )
      );
    }

    function canScoreMatch(tourneyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (tourneyId != null && isTournamentScorer(tourneyId))
      );
    }

    function isValidNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // =========================================================================
    // 2. TOURNAMENTS COLLECTION
    // =========================================================================
    match /tournaments/{tournamentId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidNonEmptyString(request.resource.data.name, 120) &&
        (
          request.resource.data.ownerId == request.auth.uid ||
          request.resource.data.ownerEmail == request.auth.token.email ||
          isSuperAdmin()
        );

      allow update: if isSignedIn() &&
        isTournamentOwner(tournamentId) &&
        (
          !('ownerId' in request.resource.data) ||
          !('ownerId' in resource.data) ||
          request.resource.data.ownerId == resource.data.ownerId ||
          isSuperAdmin()
        );

      allow delete: if isSignedIn() && isTournamentOwner(tournamentId);
    }

    // =========================================================================
    // 3. TEAMS & ROSTERS COLLECTION
    // =========================================================================
    match /teams/{teamId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidNonEmptyString(request.resource.data.name, 100) &&
        (
          request.resource.data.ownerId == request.auth.uid ||
          request.resource.data.ownerEmail == request.auth.token.email ||
          (request.resource.data.tournamentId != null && isTournamentAdmin(request.resource.data.tournamentId)) ||
          isSuperAdmin()
        );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.ownerId == request.auth.uid) ||
        (resource.data.ownerEmail == request.auth.token.email) ||
        (resource.data.ownerId == ('tm_' + request.auth.token.email)) ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId))
      ) && (
        !('ownerId' in request.resource.data) ||
        !('ownerId' in resource.data) ||
        request.resource.data.ownerId == resource.data.ownerId ||
        isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.ownerId == request.auth.uid) ||
        (resource.data.ownerEmail == request.auth.token.email) ||
        (resource.data.ownerId == ('tm_' + request.auth.token.email)) ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId))
      );
    }

    // =========================================================================
    // 4. PLAYERS COLLECTION
    // =========================================================================
    match /players/{playerId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidNonEmptyString(request.resource.data.name, 100) &&
        (
          isSuperAdmin() ||
          (request.resource.data.teamId != null && isTeamManager(request.resource.data.teamId)) ||
          (request.resource.data.tournamentId != null && isTournamentAdmin(request.resource.data.tournamentId))
        );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.teamId != null && isTeamManager(resource.data.teamId)) ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        (request.resource.data.teamId != null && isTeamManager(request.resource.data.teamId)) ||
        (request.resource.data.tournamentId != null && isTournamentAdmin(request.resource.data.tournamentId))
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.teamId != null && isTeamManager(resource.data.teamId)) ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId))
      );
    }

    // =========================================================================
    // 5. MATCHES COLLECTION
    // =========================================================================
    match /matches/{matchId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.resource.data.tournamentId != null &&
          isTournamentAdmin(request.resource.data.tournamentId)
        ) ||
        (
          request.resource.data.teamAId != null &&
          isTeamManager(request.resource.data.teamAId)
        ) ||
        (
          request.resource.data.teamBId != null &&
          isTeamManager(request.resource.data.teamBId)
        )
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (
          resource.data.tournamentId != null &&
          isTournamentAdmin(resource.data.tournamentId)
        ) ||
        (
          resource.data.teamAId != null &&
          isTeamManager(resource.data.teamAId)
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          resource.data.tournamentId != null &&
          canScoreMatch(resource.data.tournamentId)
        ) ||
        (
          request.resource.data.tournamentId != null &&
          canScoreMatch(request.resource.data.tournamentId)
        ) ||
        (
          resource.data.teamAId != null &&
          isTeamManager(resource.data.teamAId)
        ) ||
        (
          resource.data.teamBId != null &&
          isTeamManager(resource.data.teamBId)
        )
      );

      match /{subcollection=**} {
        allow read: if true;
        allow write: if isSignedIn() && (
          isSuperAdmin() ||
          (
            resource.data.tournamentId != null &&
            canScoreMatch(resource.data.tournamentId)
          ) ||
          (
            resource.data.teamAId != null &&
            isTeamManager(resource.data.teamAId)
          ) ||
          (
            resource.data.teamBId != null &&
            isTeamManager(resource.data.teamBId)
          )
        );
      }
    }

    // =========================================================================
    // 6. INNINGS & SCORECARD COLLECTIONS (BATCH WRITE & MANAGER COMPLIANT)
    // =========================================================================
    match /innings/{inningsId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.tournamentId != null && canScoreMatch(request.resource.data.tournamentId)) ||
        (
          request.resource.data.matchId != null &&
          exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId)) &&
          (
            canScoreMatch(get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.tournamentId) ||
            isTeamManager(get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.teamAId) ||
            isTeamManager(get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.teamBId)
          )
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && canScoreMatch(resource.data.tournamentId)) ||
        (request.resource.data.tournamentId != null && canScoreMatch(request.resource.data.tournamentId)) ||
        (
          resource.data.matchId != null &&
          exists(/databases/$(database)/documents/matches/$(resource.data.matchId)) &&
          (
            canScoreMatch(get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.tournamentId) ||
            isTeamManager(get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.teamAId) ||
            isTeamManager(get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.teamBId)
          )
        )
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId))
      );

      match /{subcollection=**} {
        allow read: if true;
        allow write: if isSignedIn() && (
          isSuperAdmin() ||
          (resource.data.tournamentId != null && canScoreMatch(resource.data.tournamentId))
        );
      }
    }

    match /battingScores/{scoreId} {
      allow read: if true;

      allow create, update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.tournamentId != null && canScoreMatch(request.resource.data.tournamentId)) ||
        (
          request.resource.data.matchId != null &&
          exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId)) &&
          canScoreMatch(get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.tournamentId)
        ) ||
        (
          request.resource.data.inningsId != null &&
          exists(/databases/$(database)/documents/innings/$(request.resource.data.inningsId)) &&
          canScoreMatch(get(/databases/$(database)/documents/innings/$(request.resource.data.inningsId)).data.tournamentId)
        )
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId))
      );
    }

    match /bowlingScores/{scoreId} {
      allow read: if true;

      allow create, update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.tournamentId != null && canScoreMatch(request.resource.data.tournamentId)) ||
        (
          request.resource.data.matchId != null &&
          exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId)) &&
          canScoreMatch(get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.tournamentId)
        ) ||
        (
          request.resource.data.inningsId != null &&
          exists(/databases/$(database)/documents/innings/$(request.resource.data.inningsId)) &&
          canScoreMatch(get(/databases/$(database)/documents/innings/$(request.resource.data.inningsId)).data.tournamentId)
        )
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId))
      );
    }

    // =========================================================================
    // 7. STANDINGS & POINTS TABLE
    // =========================================================================
    match /standings/{standingId} {
      allow read: if true;

      allow write: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.tournamentId != null && isTournamentScorer(request.resource.data.tournamentId)) ||
        (resource.data.tournamentId != null && isTournamentScorer(resource.data.tournamentId))
      );
    }

    // =========================================================================
    // 8. TOURNAMENT MEMBERS
    // =========================================================================
    match /tournamentMembers/{memberId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.resource.data.tournamentId != null &&
          (
            isTournamentOwner(request.resource.data.tournamentId) ||
            (
              exists(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)) &&
              (
                get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.ownerId == request.auth.uid ||
                get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.ownerEmail == request.auth.token.email
              )
            )
          )
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          resource.data.tournamentId != null &&
          isTournamentOwner(resource.data.tournamentId)
        )
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentOwner(resource.data.tournamentId))
      );
    }

    // =========================================================================
    // 9. TOURNAMENT TEAM MEMBERSHIPS
    // =========================================================================
    match /tournamentTeamMemberships/{membershipId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.tournamentId != null && isTournamentAdmin(request.resource.data.tournamentId)) ||
        (
          request.resource.data.teamId != null &&
          isTeamManager(request.resource.data.teamId) &&
          request.resource.data.status == 'PENDING'
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        (resource.data.teamId != null && isTeamManager(resource.data.teamId)) ||
        (request.resource.data.tournamentId != null && isTournamentAdmin(request.resource.data.tournamentId)) ||
        (request.resource.data.teamId != null && isTeamManager(request.resource.data.teamId))
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.tournamentId != null && isTournamentAdmin(resource.data.tournamentId)) ||
        (resource.data.teamId != null && isTeamManager(resource.data.teamId))
      );
    }

    // =========================================================================
    // 10. USER PROFILES
    // =========================================================================
    match /users/{userId} {
      allow read: if isUser(userId) || isSuperAdmin();
      allow write: if isUser(userId) || isSuperAdmin();
    }

    // =========================================================================
    // 11. SYSTEM ADMINISTRATORS
    // =========================================================================
    match /system_admins/{adminId} {
      allow read: if isSignedIn() && (
        request.auth.uid == adminId ||
        request.auth.token.email == 'ahsanhayat092@gmail.com' ||
        request.auth.uid == 'org_ahsanhayat092_gmail_com'
      );
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 12. TEAM CHALLENGES & FRIENDLIES
    // =========================================================================
    match /teamChallenges/{challengeId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.resource.data.challengerTeamId != null &&
          isTeamManager(request.resource.data.challengerTeamId)
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          resource.data.challengerTeamId != null &&
          isTeamManager(resource.data.challengerTeamId)
        ) ||
        (
          resource.data.opponentTeamId != null &&
          isTeamManager(resource.data.opponentTeamId)
        ) ||
        (
          request.resource.data.challengerTeamId != null &&
          isTeamManager(request.resource.data.challengerTeamId)
        ) ||
        (
          request.resource.data.opponentTeamId != null &&
          isTeamManager(request.resource.data.opponentTeamId)
        )
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (
          resource.data.challengerTeamId != null &&
          isTeamManager(resource.data.challengerTeamId)
        )
      );
    }
  }
}
